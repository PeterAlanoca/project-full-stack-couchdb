# ============================================================
# .gitignore — Club de Videos (NestJS + Angular + CouchDB)
# ============================================================

# --- Node / npm ---------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Variables de entorno -----------------------------------
.env
.env.local
.env.*.local
# .env.example  <- sí se versiona (plantilla pública)

# --- Backend (NestJS / TypeScript) --------------------------
backend/dist/
backend/node_modules/
backend/tsconfig.build.tsbuildinfo
backend/coverage/

# --- Frontend (Angular) -------------------------------------
frontend/dist/
frontend/node_modules/
frontend/.angular/cache/
frontend/coverage/
frontend/.sass-cache/
frontend/connect.lock
frontend/out-tsc/
frontend/tmp/

# --- Docker / CouchDB ---------------------------------------
# Datos persistidos por volúmenes de Docker
couchdb-data/
couchdb_data/
docker-volumes/
*.log

# --- IDEs y editores ----------------------------------------
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Visual Studio Code (se versionan solo configs compartidas)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/

# --- Sistema operativo --------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Testing / Cobertura ------------------------------------
coverage/
*.lcov
.nyc_output/
__screenshots__/

# --- Builds / compilados ------------------------------------
dist/
build/
out/
